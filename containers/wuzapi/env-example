# .env
# Token for WuzAPI Admin
WUZAPI_ADMIN_TOKEN=change-me

# Image (defina a imagem WuzAPI a ser usada)
WUZAPI_IMAGE=change-me/wuzapi:latest

# Route domain
URLAPP=wuzapi.example.com

# WuzAPI Session Configuration
SESSION_DEVICE_NAME=WuzAPI

# Server Configuration
WUZAPI_PORT=8080

# Database configuration
DB_USER=wuzapi_user
DB_PASSWORD=change-me
DB_NAME=wuzapi_db
DB_HOST=db.example.local
DB_PORT=5432
DB_SSLMODE=false
TZ=America/Sao_Paulo

# Global webhook URL
WUZAPI_GLOBAL_WEBHOOK=https://wuzapi.example.com/webhook

# "json" or "form" for the default
WEBHOOK_FORMAT=json

# RabbitMQ configuration Optional
RABBITMQ_HOST=rabbitmq.example.local
RABBITMQ_USER=wuzapi_user
RABBITMQ_PASSWORD=change-me
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:5671/%2F
RABBITMQ_QUEUE=wuzapi
